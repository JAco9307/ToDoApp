@page "/"
@using Todo.utility

<PageTitle>Home</PageTitle>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 32px;
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        color: #222;
    }

    h1 {
        margin: 0 0 24px;
    }

    .board {
        display: grid;
        grid-template-columns: repeat(3, minmax(220px, 1fr));
        gap: 16px;
        align-items: start;
    }

    .column {
        min-height: 300px;
        padding: 16px;
        background: #e8ecf1;
        border-radius: 10px;
    }

        .column h2 {
            margin: 0 0 14px;
            font-size: 1.1rem;
        }

    .card {
        touch-action: none;
        user-select: none;
    }

        .card.dragging {
            opacity: 0.5;
        }

    .column.drag-over {
        background: #dce3ff;
    }

    @@media (max-width: 700px) {
        body {
            padding: 20px;
        }

        .board {
            grid-template-columns: 1fr;
        }
    }
</style>

