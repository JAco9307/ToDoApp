@page "/"
@using Syncfusion.Blazor.DropDowns
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 32px;
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        color: #222;
    }

    h1 {
        margin: 0 0 24px;
    }

    .board {
        display: flex;
        gap: 20px;
        padding: 20px;
    }

    .column {
        min-height: 300px;
        padding: 16px;
        background: #e8ecf1;
        border-radius: 10px;
        display: inline;
    }
        .column h2 {
            margin: 0 0 14px;
            font-size: 1.1rem;
        }

    .card {
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 8px;
    }
        .card span {
            display: grid;
            grid-template-columns: 180px 1fr 70px;
            align-items: center;
            gap: 10px;
        }

        .card button {
            width: 100%;
            padding: 8px;
            cursor: pointer;
        }
    .top-row{
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        width: 100%;
    }

</style>

<main>
    <div class="top-row">
        <button @onclick="OpenOptions">Options</button>
    </div>
    <div class="board">
        <section class="column" aria-label="To Do">
            <h2 style="display: flex; justify-content: space-between; align-items: center;">
                <SfDropDownList TValue="string"
                                TItem="string"
                                DataSource="@ListNames"
                                @bind-Value="@SelectedList">
                    <DropDownListEvents TValue="string"
                                        TItem="string"
                                        ValueChange="@UpdateComboboxListSelection"/>
                </SfDropDownList>
                <button @onclick="NewTodo">New todo</button>
            </h2>
            @foreach (var todo in TodoDatas ?? Array.Empty<TodoData>())
            { 
                <div class="card" draggable="true">
                    <span>
                        <button @onclick="() => CycleStatus(TodoDatas.IndexOf(todo))">@todo.Status</button>
                        @todo.Title
                        <button @onclick="() => ShowEdit(TodoDatas.IndexOf(todo))">Edit</button>
                    </span>
                </div>
            }
        </section>
    </div>
    <EditDialog @ref="popupRef" />
    <OptionsDialog @ref="optionsRef"/>
</main>