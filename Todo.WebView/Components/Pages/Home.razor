@page "/"
@rendermode InteractiveServer
@using Todo.utility

<PageTitle>Home</PageTitle>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 32px;
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        color: #222;
    }

    h1 {
        margin: 0 0 24px;
    }

    .board {
        display: flex;
        gap: 20px;
        padding: 20px;
    }

    .column {
        min-height: 300px;
        padding: 16px;
        background: #e8ecf1;
        border-radius: 10px;
        display: inline;
    }
        .column h2 {
            margin: 0 0 14px;
            font-size: 1.1rem;
        }

    .card {
        touch-action: none;
        user-select: none;
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 8px;
    }

        .card.dragging {
            opacity: 0.5;
        }

        .card span {
            display: grid;
            grid-template-columns: 180px 1fr 70px;
            align-items: center;
            gap: 10px;
        }

        .card button {
            width: 100%;
            padding: 8px;
            cursor: pointer;
        }

    .column.drag-over {
        background: #dce3ff;
    }

    @@media (max-width: 700px) {
        body {
            padding: 20px;
        }

        .board {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="board">
    <section class="column" aria-label="To Do">
        <h2>@TodoDatas?.First().ListTitle</h2>
        @foreach (var todo in TodoDatas ?? Array.Empty<TodoData>())
        { 
            <div class="card" draggable="true">
                <span>
                    <button @onclick="() => CycleStatus(TodoDatas.IndexOf(todo))">@todo.Status</button>
                    @todo.Title
                    <button>Edit</button>
                </span>
            </div>
        }
    </section>

</main>
