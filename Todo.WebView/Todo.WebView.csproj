<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<OutputType>Exe</OutputType>
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
		<RestoreProjectStyle>PackageReference</RestoreProjectStyle>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
	  <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Todo.utility\Todo.utility.csproj" />
	</ItemGroup>

</Project>
